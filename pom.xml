<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 统一继承 Spring Boot 4.0.3 的依赖版本和 Maven 插件配置。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>com.susan.training</groupId>
    <artifactId>demo-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>spring-boot4-demo</name>
    <description>Spring Boot 4.0 multi-module project example</description>

    <!-- 根工程只负责聚合，数据库适配层与 Web 层保持清晰边界。 -->
    <modules>
        <module>demo-common</module>
        <module>demo-greeting-starter</module>
        <module>demo-order</module>
        <module>demo-persistence</module>
        <module>demo-integration</module>
        <module>demo-web</module>
    </modules>

    <properties>
        <!-- 示例统一以 Java 21 编译，避免不同电脑的默认 JDK 造成结果差异。 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Springdoc 3.x 为 Spring Boot 4 提供 OpenAPI 与 Swagger UI。 -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- MyBatis 4.x 对应 Spring Boot 4，避免沿用 3.x 集成包。 -->
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <!-- Redisson 与 RocketMQ 客户端独立于 Spring Boot BOM，版本在这里集中固定。 -->
        <redisson.version>3.23.2</redisson.version>
        <rocketmq-client.version>4.9.4</rocketmq-client.version>
        <minio.version>8.5.9</minio.version>
        <poi.version>5.4.1</poi.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 2.x 统一管理 ChatClient、模型核心和向量接口版本。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
