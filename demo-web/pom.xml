<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.susan.training</groupId>
        <artifactId>demo-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>demo-web</artifactId>

    <dependencies>
        <!-- Web 模块依赖订单业务，由它完成 HTTP 协议适配。 -->
        <dependency>
            <groupId>com.susan.training</groupId>
            <artifactId>demo-order</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Web 层通过持久化模块使用 MyBatis、JPA 和 PostgreSQL。 -->
        <dependency>
            <groupId>com.susan.training</groupId>
            <artifactId>demo-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 缓存、概念消息、锁和搜索等中间件适配器集中放在集成模块。 -->
        <dependency>
            <groupId>com.susan.training</groupId>
            <artifactId>demo-integration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 引入自定义 Starter 后，GreetingService 由自动配置负责创建。 -->
        <dependency>
            <groupId>com.susan.training</groupId>
            <artifactId>demo-greeting-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Boot 4 创建 MVC 应用时优先使用细分的 webmvc Starter。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 提供 Jakarta Bean Validation 的参数校验实现。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 为健康检查、指标和后续生产监控提供基础能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 端点把 Micrometer 指标转换为标准抓取格式。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- HTTP 请求和自定义 Observation 通过 OTLP 导出到追踪后端。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- 生成 OpenAPI JSON/YAML，并提供可直接调试接口的 Swagger UI。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- 提供原生 WebSocket 服务端能力，用于订单状态实时推送。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Spring Boot 4 将 RestClient 自动配置拆为独立 Starter。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- 第六章使用 Security 过滤器链、方法权限和密码编码器。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Resource Server 负责验证 JWT 签名、过期时间与声明。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- OAuth2 Client 用于企业 OIDC 单点登录，没有配置时不会启用登录链。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Resilience4j 独立组合熔断、限流和重试策略。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-ratelimiter</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <!-- 使用 Spring AI ChatClient 编排企业知识库提示词和回答。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc 安全测试工具提供带认证用户的请求构造器。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 在真实 PostgreSQL 容器中验证迁移与查询。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 将 MVC 测试能力拆为独立 Starter。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 自动化数据库测试不需要 Docker，会在测试进程内启动 PostgreSQL。 -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
        <!-- 默认 H2 Profile 让前 14 篇教程在没有 PostgreSQL 时仍可启动。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把 Web 模块及依赖的业务模块重新打包为可执行 JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
